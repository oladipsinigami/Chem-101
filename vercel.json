{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "bank/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__path=/api/$1" },
    { "source": "/api", "destination": "/api?__path=/api" },
    { "source": "/health", "destination": "/api?__path=/health" },
    { "source": "/verify/(.*)", "destination": "/api?__path=/verify/$1" }
  ]
}
